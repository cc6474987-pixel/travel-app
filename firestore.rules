rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Data lives under trips/<trip password>/...; without the password nobody can find it.
    match /trips/{code}/{coll}/{doc} {
      allow read: if true;
      // Members, "paid" marks and deleting expenses need the admin password in the app.
      // The app marks those writes with v == 2; old copies of the app can't, so they are refused.
      allow create: if (coll != 'settled' && !(coll == 'shared' && doc == 'people')) || request.resource.data.v == 2;
      allow update: if (coll != 'expenses' && coll != 'settled' && !(coll == 'shared' && doc == 'people')) || request.resource.data.v == 2;
      allow delete: if coll != 'expenses' && coll != 'settled' && !(coll == 'shared' && doc == 'people');
    }
  }
}
